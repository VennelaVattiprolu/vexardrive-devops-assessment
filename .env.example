# Copy to .env for local development. NEVER commit a real .env file.
# In Azure, these are supplied as Container Apps secrets sourced from Key
# Vault - see infra/ and docs/REPORT.md, Secrets & Identity.

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=vexaradmin
DB_PASSWORD=changeme_local_only
DB_NAME=vexar_fleet
DB_SSL=false
DB_POOL_MAX=10

JWT_SECRET=changeme_local_dev_secret_do_not_use_in_prod
JWT_EXPIRES_IN=24h

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
